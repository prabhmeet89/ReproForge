// This file is the Prisma schema for ReproForge
// SQLite is used for local development (no Docker required)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums stored as String in SQLite
// BugStatus: submitted, investigating, investigated, test_generated, reproduced, unverified, failed
// TestStatus: queued, running, passed, failed, timed_out, infra_error
// ProjectSourceType: zip, sample, github

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  passwordHash String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  projects   Project[]
  bugReports BugReport[]
  sessions   Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId, expiresAt])
}

model Project {
  id            String   @id @default(uuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  repositoryUrl String?
  defaultBranch String   @default("main")
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bugReports    BugReport[]

  @@index([ownerId, createdAt])
}

model BugReport {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  description       String
  expectedBehavior String?
  actualBehavior   String?
  affectedEndpoint String?
  stackTrace       String?
  logs             String?
  status           String   @default("submitted")
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  testRuns         TestRun[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model TestRun {
  id                  String    @id @default(uuid())
  bugReportId         String
  bugReport           BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  status              String    @default("queued")
  exitCode            Int?
  durationMs          Int?
  generatedTestVersion String?
  commitSha           String?
  outputRef           String?
  stdout              String?
  stderr              String?
  isDemo              Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([bugReportId, createdAt])
}