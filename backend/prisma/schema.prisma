// This file is the Prisma schema for ReproForge
// SQLite is used for local development (no Docker required)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums stored as String in SQLite
// BugStatus: submitted, investigating, investigated, test_generated, reproduced, unverified, failed
// TestStatus: queued, running, passed, failed, timed_out, infra_error
// ProjectSourceType: zip, sample, github
// SnapshotSource: zip, sample, github
// SnapshotStatus: processing, ready, failed
// FileKind: source, test, config, doc, other

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  passwordHash String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  projects   Project[]
  bugReports BugReport[]
  sessions   Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId, expiresAt])
}

model Project {
  id            String   @id @default(uuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  repositoryUrl String?
  defaultBranch String   @default("main")
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bugReports    BugReport[]
  snapshots     RepoSnapshot[]

  @@index([ownerId, createdAt])
}

model BugReport {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  description       String
  expectedBehavior String?
  actualBehavior   String?
  affectedEndpoint String?
  stackTrace       String?
  logs             String?
  status           String   @default("submitted")
  isDemo           Boolean  @default(false)
  snapshotId       String?
  snapshot         RepoSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  testRuns         TestRun[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model TestRun {
  id                  String    @id @default(uuid())
  bugReportId         String
  bugReport           BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  status              String    @default("queued")
  exitCode            Int?
  durationMs          Int?
  generatedTestVersion String?
  commitSha           String?
  outputRef           String?
  stdout              String?
  stderr              String?
  isDemo              Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([bugReportId, createdAt])
}

model RepoSnapshot {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source             String   // zip | sample | github
  label              String?
  status             String   @default("processing") // processing | ready | failed
  errorCode          String?
  errorMessage       String?
  contentHash        String
  commitSha          String?
  fileCount          Int      @default(0)
  totalBytes         Int      @default(0)
  excludedCount      Int      @default(0)
  storageKey         String
  analysis           String?  // JSON stored as String
  secretFindingCount Int      @default(0)
  createdAt          DateTime @default(now())
  files              SnapshotFile[]
  bugReports         BugReport[]

  @@unique([projectId, contentHash])
  @@index([projectId, createdAt])
}

model SnapshotFile {
  id              String       @id @default(uuid())
  snapshotId      String
  snapshot        RepoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  path            String
  size            Int
  sha256          String
  lineCount       Int          @default(0)
  language        String?
  kind            String       @default("other") // source | test | config | doc | other
  secretFindings  String?      // JSON stored as String

  @@unique([snapshotId, path])
  @@index([snapshotId, kind])
}