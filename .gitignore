# Dependencies
node_modules/

# Environment files (NEVER commit real secrets)
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# TypeScript cache
*.tsbuildinfo

# Prisma / SQLite database files
# The migration SQL in backend/prisma/migrations/ IS committed — only the
# local database files are not.
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-wal
backend/prisma/*.db-shm

# Artifact storage (uploaded zips / extracted snapshots)
uploads/
artifacts/
storage/
backend/storage/

# AI tool skill directories (generated, duplicated per tool)
.agents/
.claude/
.cursor/
.devin/
