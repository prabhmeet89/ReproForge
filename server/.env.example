# Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!

PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Prisma datasource — SQLite file for local development.
# The path is relative to the server/prisma/ directory.
DATABASE_URL="file:./dev.db"

# Set to true to seed the demo dataset on server start.
# The seed skips an already-populated database, so this is safe to leave on.
SEED_DEMO_DATA=false

# --- Authentication ---
# Name of the cookie that carries the session token.
SESSION_COOKIE_NAME=reproforge_session

# How long a session stays valid, in days.
SESSION_TTL_DAYS=7

# Rate limit for the login/signup endpoints, per IP.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
