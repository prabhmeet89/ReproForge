# Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!

PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Prisma datasource — SQLite file for local development.
# The path is relative to the server/prisma/ directory.
DATABASE_URL="file:./dev.db"

# Set to true to seed the demo dataset on server start.
# The seed skips an already-populated database, so this is safe to leave on.
SEED_DEMO_DATA=false
